{
  "name": "@neon-rs/cli",
  "version": "0.2.3",
  "description": "Command-line build tool for Neon modules.",
  "type": "module",
  "exports": "./index.js",
  "types": "types/index.d.ts",
  "files": [
    "index.js",
    "LICENSE*"
  ],
  "bin": {
    "neon": "./index.js"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "prepack": "cp package.json package.json.bak && ncc build src/index.ts -o . && jq -f prepack.jq package.json.bak > package.json",
    "postpack": "mv package.json.bak package.json && rm -f index.js",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neon-bindings/neon-rs.git"
  },
  "keywords": [
    "Neon",
    "Rust",
    "Node"
  ],
  "author": "Dave Herman <david.herman@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neon-bindings/neon-rs/issues"
  },
  "homepage": "https://github.com/neon-bindings/neon-rs#readme",
  "devDependencies": {
    "@tsconfig/node16": "^1.0.3",
    "@types/chai": "^4.3.16",
    "@types/command-line-args": "^5.2.0",
    "@types/command-line-commands": "^2.0.1",
    "@types/command-line-usage": "^5.0.2",
    "@types/jscodeshift": "^0.11.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.15.11",
    "@types/temp": "^0.9.1",
    "@vercel/ncc": "^0.36.1",
    "chai": "^5.1.1",
    "mocha": "^10.4.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@neon-rs/artifact": "*",
    "@neon-rs/load": "*",
    "@neon-rs/manifest": "*",
    "cargo-messages": "*",
    "chalk": "^5.2.0",
    "command-line-args": "^5.2.1",
    "command-line-commands": "^3.0.2",
    "command-line-usage": "^7.0.1",
    "execa": "^7.1.1",
    "jscodeshift": "^0.15.1",
    "stream-to-string": "^1.2.1",
    "temp": "^0.9.4"
  }
}
